# ==============================================================================
# Day 24 DevOps / AWS Focus: Production Environment Variables & Secrets
# NEVER commit real credentials to GitHub. Copy to .env and configure.
# ==============================================================================

# 1. Application Core & Security
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-256-bit-hex-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 2. Database & In-Memory Broker
DATABASE_URL=postgresql+psycopg2://rmart_user:rmart_secure_pass_2026@localhost:5432/rmart_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 3. Observability, Logging & Sentry Real-Time Error Tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGGING=true

# 4. AWS Infrastructure & Static Assets
AWS_REGION=us-east-1
AWS_S3_BUCKET=rmart-static-assets-2026
CLOUDWATCH_NAMESPACE=RMart/Production

# 5. Frontend (Vercel) & Public API Endpoints
VITE_API_URL=https://api.rmart.store/api/v1
VITE_WS_URL=wss://api.rmart.store/ws
