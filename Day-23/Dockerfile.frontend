# ==============================================================================
# Day 23 DevOps: Multi-Stage Production Dockerfile for React SPA Frontend
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Stage (compiles modern React 19 + Vite bundle)
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Optimize layer caching: Install dependencies first
COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps || npm install

# Copy application assets, source code, and configuration
COPY . .

# Build production assets (Vite produces optimized, tree-shaken dist/)
ARG VITE_API_URL=/api/v1
ARG VITE_WS_URL=/ws
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL

RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Production Nginx Server (ultra-lean, high-throughput static host)
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS production

# Copy custom high-performance Nginx configuration
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Healthcheck to verify Nginx availability
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -q -O - http://localhost/nginx-health || exit 1

# Launch Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
