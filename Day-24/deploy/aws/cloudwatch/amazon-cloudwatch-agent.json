{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/rmart/app.log",
            "log_group_name": "/rmart/production/backend",
            "log_stream_name": "{instance_id}-app.log",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/rmart/error.log",
            "log_group_name": "/rmart/production/backend-errors",
            "log_stream_name": "{instance_id}-error.log",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/rmart_access.log",
            "log_group_name": "/rmart/production/nginx-access",
            "log_stream_name": "{instance_id}-access.log",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/rmart_error.log",
            "log_group_name": "/rmart/production/nginx-error",
            "log_stream_name": "{instance_id}-nginx-error.log",
            "timezone": "UTC"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "CWAgent",
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait",
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "metrics_collection_interval": 60,
        "totalcpu": true
      },
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ]
      }
    }
  }
}
