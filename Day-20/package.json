{
    "name": "day-20-ai-rag-streaming",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "backend": "uvicorn backend.main:app --reload --port 8000",
        "celery": "celery -A backend.tasks.celery_app worker --loglevel=info",
        "seed": "python backend/seed_db.py",
        "db:show": "python show_database.py",
        "test:backend": "pytest backend/tests",
        "build": "vite build",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:demo": "playwright test e2e/realtimeIntegration.spec.js --headed",
        "test:ci": "npm run typecheck && npm run test && npm run test:backend && npm run test:e2e"
    },
