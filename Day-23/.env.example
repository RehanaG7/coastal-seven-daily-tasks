# ==============================================================================
# Day 23 DevOps: Environment Variables & Secret Configuration Template
# Instructions: Copy to .env and replace placeholder values. NEVER commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Security
# ------------------------------------------------------------------------------
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-random-256-bit-key-here-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 2. PostgreSQL Relational Database (Docker Compose or Cloud RDS)
# ------------------------------------------------------------------------------
POSTGRES_USER=rmart_user
POSTGRES_PASSWORD=rmart_secure_pass_2026
POSTGRES_DB=rmart_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# In Docker Compose, service name 'db' resolves via internal Docker bridge network:
DATABASE_URL=postgresql+psycopg2://rmart_user:rmart_secure_pass_2026@db:5432/rmart_db

# For local development outside Docker (e.g., SQLite or local Postgres):
# DATABASE_URL=sqlite:///./ecommerce.db
# DATABASE_URL=postgresql+psycopg2://rmart_user:rmart_secure_pass_2026@localhost:5432/rmart_db

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Asynchronous Message Broker
# ------------------------------------------------------------------------------
# In Docker Compose, service name 'redis' resolves via Docker bridge network:
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# For local development outside Docker:
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Artificial Intelligence & Multi-LLM API Keys (Free Tier)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Frontend Client Build Environment Targets (Vite)
# ------------------------------------------------------------------------------
# In Docker with Nginx reverse proxy, relative paths route through Nginx:
VITE_API_URL=/api/v1
VITE_WS_URL=/ws

# For local Vite development outside Docker:
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_WS_URL=ws://localhost:8000/ws
