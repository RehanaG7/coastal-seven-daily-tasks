{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3AssetSync",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::rmart-static-assets-2026",
        "arn:aws:s3:::rmart-static-assets-2026/*"
      ]
    },
    {
      "Sid": "AllowEC2DeploymentCommandViaSSM",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand",
        "ssm:GetCommandInvocation"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ssm:*:*:document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "AllowEC2DescribeForDeployment",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
